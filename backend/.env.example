# B18 example for local backend development. NEVER place real secrets here.
# Copy to repository-root .env (../.env relative to backend/) or inject
# these as environment variables on Render. Environment values take precedence.
# Required for startup:
DB_HOST=localhost
DB_NAME=parvah_dev
DB_USER=parvah_app
DB_PASSWORD=REPLACE_WITH_LOCAL_SECRET
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS

# Optional (defaults in code or pg):
DB_PORT=5432
PORT=5000
DB_SSL=false

# Optional test-only overrides; use isolated, disposable database credentials.
# PRE_ER_TEST_ENV_FILE=/path/to/isolated-test.env
# PRE_ER_TEST_DATABASE_NAME=parvah_test

# Additional mail/invitation settings may be required for specific routes;
# refer to README / mailer configuration before deploying invitations.
