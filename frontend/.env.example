# Copy this file to .env and edit.

# true  = use built-in sample data, no backend needed
# false = call the real backend
VITE_USE_MOCK=true

# Address of Patrika's backend (used by the dev proxy). Her default port is 5000.
VITE_API_URL=http://localhost:5000

# For a deployed frontend (Vercel etc.): the backend URL, e.g. https://your-api.onrender.com
# VITE_API_BASE=
